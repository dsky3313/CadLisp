;반띵 오프셋
;; 선택한 LINE/ARC 를 중심으로 양쪽 (거리/2)씩 띄운 이중선을 현재 레이어에 그린다
(defun c:33 ( / dist half ss i ed typ p1 p2 ang cen r a1 a2 nrm n s rr)
  (if (and (setq dist (getdist "\n【33】 Select line of Distance <of>: "))
           (> dist 0)
           (setq ss (progn (princ "\n【33】 ") (ssget '((0 . "LINE,ARC"))))))
    (progn
      (setq half (/ dist 2.0) n 0 i 0)
      (repeat (sslength ss)
        (setq ed  (entget (ssname ss i))
              typ (cdr (assoc 0 ed))
              i   (1+ i))
        (cond
          ((= typ "LINE")
           (setq p1  (cdr (assoc 10 ed))
                 p2  (cdr (assoc 11 ed))
                 ang (angle p1 p2))
           (foreach s (list (/ pi 2.0) (- (/ pi 2.0)))
             (entmake (list '(0 . "LINE")
                            (cons 10 (polar p1 (+ ang s) half))
                            (cons 11 (polar p2 (+ ang s) half)))))
           (setq n (1+ n)))
          ((= typ "ARC")
           (setq cen (cdr (assoc 10 ed))
                 r   (cdr (assoc 40 ed))
                 a1  (cdr (assoc 50 ed))
                 a2  (cdr (assoc 51 ed))
                 nrm (assoc 210 ed))
           (if (> r half)
             (progn
               (foreach rr (list (+ r half) (- r half))
                 (entmake (append (list '(0 . "ARC") (cons 10 cen) (cons 40 rr)
                                        (cons 50 a1) (cons 51 a2))
                                  (if nrm (list nrm)))))
               (setq n (1+ n)))
             (princ "\n반지름이 간격의 절반 이하인 호는 건너뜁니다.")))))
      (princ (strcat "\n" (itoa n) "개 객체 처리 완료."))))
  (princ))