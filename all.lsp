(defun c:alldelete(/ alldelete)
	(if (= alldelete_Y_N nil)
		(setq alldelete_Y_N "Yes")
	)
	(initget 1 "Yes No")
	(setq alldelete (getkword (strcat "\n【all】 Align의 원본 객체를 지우시겠어요? [ Yes / No ] : <" alldelete_Y_N ">")))
	(if (/= alldelete nil)
		(setq alldelete_Y_N alldelete)
	)
)


(defun c:allscale(/ allscale)
	(if (= allscale_Y_N nil)
		(setq allscale_Y_N "Yes")
	)
	(initget 1 "Yes No")
	(setq allscale (getkword (strcat "\n【all】 Align을 사용할 때에 축척을 조절하시겠어요? [ Yes / No ] : <" allscale_Y_N ">")))
	(if (/= allscale nil)
		(setq allscale_Y_N allscale)
	)
)


(defun c:all(/ *error* ent fpt1 fpt2 spt1 spt2 marker n entnamelist entname enttemp )
	(arxload "geom3d")
	(if (= alldelete_Y_N nil)
		(setq alldelete_Y_N "Yes")
	)
	(if (= allscale_Y_N nil)
		(setq allscale_Y_N "Yes")
	)
	(setq ent (progn (princ "\n【all】 ") (ssget)))
	(setq fpt1 (getpoint "\n【all】 First Origin point : "))
	(setq fpt2 (getpoint fpt1 "\n【all】 Second Origin point : "))
	(setq marker (entlast))
	(setq n 0)
	(while (ssname ent n)
		(setq entname (ssname ent n))
		(setq entnamelist (cons entname entnamelist))
		(setq n (1+ n))
	)
	(if	
		(= alldelete_Y_N "Yes")
		(if 
			(= allscale_Y_N "Yes")
			(progn
				(defun *error* (msg)
					(foreach x entnamelist (entdel x))
					(princ)
				)
				(while T
					(setq spt1 (getpoint "\n【all】 First Target point : "))
					(setq spt2 (getpoint spt1 "\n【all】 Second  Target point : "))
					(foreach x entnamelist (entmake (entget x)))
					(setq enttemp (ssadd))
					(while (setq marker (entnext marker))
						(ssadd marker enttemp)
					)
					(align enttemp fpt1 spt1 fpt2 spt2 "" "y")
					(setq enttemp nil)
					(setq marker (entlast))
				)
			);delete=y, scale=y
			(progn
